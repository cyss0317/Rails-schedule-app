<div class="mx-auto max-w-4xl p-4">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Background Jobs</h1>
    <%= render partial: "shared/icons/hamburger", locals: { current: "admin" } %>
  </div>

  <!-- Manual trigger -->
  <div class="mb-6 p-4 rounded-xl border border-gray-200 bg-white shadow-sm">
    <h2 class="text-base font-semibold text-gray-800 mb-3">Weekly Shift Generation</h2>
    <p class="text-sm text-gray-600 mb-3">
      Manually trigger the weekly shift generation job. Runs automatically every Saturday at 8PM.
    </p>
    <div class="flex items-center gap-3">
      <%= form_with url: trigger_admin_jobs_path, method: :post do |f| %>
        <div class="flex items-center gap-2">
          <label class="text-sm text-gray-700">Location ID:</label>
          <%= f.number_field :location_id,
                placeholder: ENV.fetch('DEFAULT_LOCATION_ID', 1),
                class: "w-28 rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
        </div>
        <%= f.submit "Run Now",
              class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <!-- Scheduled jobs -->
  <div class="mb-6">
    <h2 class="text-base font-semibold text-gray-800 mb-2">Scheduled (<%= @scheduled_jobs.size %>)</h2>
    <% if @scheduled_jobs.any? %>
      <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left font-medium text-gray-500">Job class</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500">Queue</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500">Scheduled at</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @scheduled_jobs.each do |job| %>
              <tr>
                <td class="px-4 py-2 font-mono text-xs text-gray-900"><%= job.job.class_name %></td>
                <td class="px-4 py-2 text-gray-600"><%= job.job.queue_name %></td>
                <td class="px-4 py-2 text-gray-500"><%= job.scheduled_at.strftime('%b %d %H:%M') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 italic">No scheduled jobs.</p>
    <% end %>
  </div>

  <!-- Failed jobs -->
  <div>
    <h2 class="text-base font-semibold text-gray-800 mb-2">Failed (<%= @failed_jobs.size %>)</h2>
    <% if @failed_jobs.any? %>
      <div class="overflow-x-auto rounded-xl border border-red-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-red-50">
            <tr>
              <th class="px-4 py-2 text-left font-medium text-gray-500">Job class</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500">Error</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500">Failed at</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @failed_jobs.each do |job| %>
              <tr>
                <td class="px-4 py-2 font-mono text-xs text-gray-900"><%= job.job.class_name %></td>
                <td class="px-4 py-2 text-red-600 text-xs truncate max-w-xs"><%= job.error.to_s.truncate(120) %></td>
                <td class="px-4 py-2 text-gray-500"><%= job.created_at.strftime('%b %d %H:%M') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 italic">No failed jobs.</p>
    <% end %>
  </div>
</div>
