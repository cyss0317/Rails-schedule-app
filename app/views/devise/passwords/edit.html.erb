<div class="m-2">
  <div class="sm:mx-auto sm:w-full sm:max-w-sm">
    <h2 class="mt-10 text-center text-2xl font-bold leading-9 tracking-tight text-gray-900">Reset your password</h2>
  </div>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= f.hidden_field :reset_password_token %>

    <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= render partial: "shared/password_field", locals: { form: f, label: "password", field: "password" } %>
      <%= render partial: "shared/password_field", locals: { form: f, label: "password_confirmation", field: "password_confirmation" } %>

      <%= render partial: "shared/button", locals: { display_text: "Change my password" } %>

      <p class="mt-10 text-center text-sm text-gray-500">
        <%= render partial: "/devise/shared/links" %>
      </p>
    </div>
  <% end %>
</div>
