<% @date_range = date_range %>

<%# Overtime alert — hidden for now; re-enable by removing the `false &&` %>
<% if false && (current_user.admin_user? || current_user.developer_user?) && @overtime_users.present? %>
  <div class="mx-auto max-w-screen-xl px-4 pt-3">
    <div class="flex items-start gap-3 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 shadow-sm">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
      </svg>
      <div>
        <p class="text-sm font-semibold text-amber-800">Overtime this week</p>
        <ul class="mt-1 space-y-0.5">
          <% @overtime_users.each do |user, hours| %>
            <li class="text-sm text-amber-700">
              <span class="font-medium"><%= user.name_and_last_name %></span>
              &mdash; <%= hours %>h
              <span class="text-amber-500">(+<%= (hours - 40).round(1) %>h over)</span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>

<%# Outer shell: flex column fills the full viewport height.
    The calendar header lives here — OUTSIDE the scroll container —
    so the hamburger drawer (position:fixed) is never trapped inside
    the overflow:auto layer that causes sticky elements to composite
    above the fixed backdrop/panel. %>
<div class="weekly-calendar-shell">
  <%= render partial: 'shared/calendar_header', locals: { calendar: calendar, start_date: date_range[0], current: "Week"} %>

<div class="weekly-calendar"
     data-controller="weekly-calendar shift-drag"
     data-weekly-calendar-location-id-value="<%= @location_id %>"
     data-weekly-calendar-row-height-value="<%= Meeting::HOUR_HEIGHT_IN_PX %>"
     data-shift-drag-row-height-value="<%= Meeting::HOUR_HEIGHT_IN_PX %>">

  <div class="table flex flex-col justify-center">
    <div class="table-header sticky top-0 md:sticky  my-sticky-offset ">
      <div class="empty-tr overflow-auto">
        <% if current_user.location_admin_user? && @users.present? %>
          <div class="employee-hours">Total Hours</div>
        <% elsif @users.present? %>
          <div class="employee-hours">Employee:</div>
        <% end %>
        <% @users_total_hours_for_week.each do |user, hours|  %>
          <div class="employee-hours shadow" style="background-color: <%= user.color %>"><%= "#{user.first_name}" %> <%= ":#{hours}" if (current_user.admin_user? || current_user.developer_user?) && @users_total_hours_for_week.present? %> </div>
        <% end %>
      </div>
      <% date_range.slice(0, 7).each do |day| %>
        <div class="weekly-date">
          <div class="date <%= 'today-date' if day.today? %>"><%= "#{day.mday}" %></div>
          <p><%= "#{t('date.abbr_day_names')[day.wday]}" %></p>

          <div class="day-off-container">

          <% if @day_offs.for_day_filtered_by_date(day.in_time_zone).present? %>
            <% day_offs = @day_offs.for_day_filtered_by_date(day.in_time_zone).sort_by(&:start_time)  %>
            <% day_offs.each do |day_off| %>
                <% if (current_user.location_admin_user? || current_user.developer_user?) || (day_off.my_day_off?(current_user) && !day_off.been_passed?) %>
                  <%= link_to "#{day_off.off_time_info(day.in_time_zone)}", edit_day_off_url(day_off.id, location_id: params[:location_id]), class: "day-off shadow flex items-center #{'current-user-day-off' if day_off.my_day_off?(current_user)} #{day_off.off_time_class(day.in_time_zone)}" %>
                <% else %>
                  <p class="day-off shadow flex items-center <%= day_off.off_time_class(day.in_time_zone) %>"> <%= day_off.off_time_info(day.in_time_zone)%> </p>
                <% end %>

                <% if day_off.morning_off?(day.in_time_zone) && day.after?(Time.now) %>
                   <%= link_to "Request Evening Off", new_location_day_off_path(day_off.location_id, start_time: day.in_time_zone.change(hour: 15), end_time: day.in_time_zone.change(hour:23)), class: "day-off shadow request-day-off-btn" %>
                <% elsif day_off.evening_off?(day.in_time_zone) && day.after?(Time.now) %>
                   <%= link_to "Request Morning Off", new_location_day_off_path(day_off.location_id, start_time: day.in_time_zone.change(hour: 9), end_time: day.in_time_zone.change(hour:15)), class: "day-off shadow request-day-off-btn" %>
                <% end %>
            <% end %>


          <% elsif day.beginning_of_day.after?(current_time) %>
            <%= link_to "Request Day", new_location_day_off_path(location_id: @location_id, start_time: day.to_s), class: "day-off shadow request-day-off-btn line-height-50" %>
          <% end %>

          </div>

        </div>
      <% end %>
    </div>

    <div class="table-body" >
      <% date_range.each_slice(7) do |week| %>

        <div class="hours">
          <% (8..23).each do |hour| %>
            <div class="hour-cell h-10" style="top: <%= table_row_top(hour) %>px"><%= hour < 12 ? "#{idx_to_time(hour)}AM" : "#{idx_to_time(hour)}PM" %></div>
          <% end %>
        </div>

        <% week.each do |day| %>
            <div data-date="<%= day.to_s %>"
                 data-controller="day-layout"
                 class="week-day meetings <%= calendar.td_classes_for(day).join(" ") %> <%= 'admin-table' if current_user.location_admin_user? || current_user.developer_user? %>">
              <% if calendar.td_classes_for(day).include?("today") %>
                <div class="current-time-liner relative <%='current-time-liner-admin' if current_user.location_admin_user? || current_user.developer_user? %>"></div>
              <% end %>
              <% sorted_events.fetch(day, []).each_with_index do |shift, idx| %>
                <%= render partial: "meetings/weekly_meeting", locals: { meeting: shift, idx: idx, classes: "weekly-meeting-#{shift.id}" } %>
              <% end %>
            </div>
          <% end %>
        <% end %>
    </div>
  </div>
</div><%# closes .weekly-calendar %>
</div><%# closes .weekly-calendar-shell %>
